# Vorlaeufige Board-Grundkonfiguration (Groessentest, nicht fuer Hardware freigegeben)
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_PINCTRL=y
# Anwendung ab Partition "app" (0x08010000) linken, Bootloader bleibt erhalten
CONFIG_USE_DT_CODE_PARTITION=y
# SysTick verliert beim Neuprogrammieren 4..5 Takte je Aufruf (Patch 0003, am Testgeraet gemessen
# mit DWT_CYCCNT: ohne Ausgleich -88 ppm, mit 5 +0,7 ppm bei etwa 1800 Aufrufen/s)
CONFIG_CORTEX_M_SYSTICK_RELOAD_COMPENSATION=5
