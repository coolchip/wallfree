# Board-Grundkonfiguration der Steuerung EV-CC-AC1-M3-CBC-RCM-ETH
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_PINCTRL=y
# Anwendung ab Partition "app" (0x08010000) linken, Bootloader bleibt erhalten
CONFIG_USE_DT_CODE_PARTITION=y
# SysTick verliert beim Neuprogrammieren 3 Takte je Aufruf (Patch 0003). Der Treiber misst den
# Wert beim Start selbst (RELOAD_COMPENSATION_AUTO, am Testgeraet 3,0); 3 gilt nur, falls das scheitert
CONFIG_CORTEX_M_SYSTICK_RELOAD_COMPENSATION=3
