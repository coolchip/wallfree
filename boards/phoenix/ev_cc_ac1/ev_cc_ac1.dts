/* SPDX-License-Identifier: Apache-2.0 */
/*
 * Board-Beschreibung der Steuerung EV-CC-AC1-M3-CBC-RCM-ETH.
 * Belege: wallbe2/docs/takt-adc-gpio.md, ethernet-phy.md, firmware-ladeadresse.md.
 * Auf der Steuerung einer wallbe Eco 2.0 in Betrieb (docs/implementierung.md).
 * Flash-Aufteilung: docs/architektur.md (Sektoren 0..2 Bootloader,
 * Sektor 3 Originalparameter, Anwendung ab 0x08010000, Parameter in Sektor 7).
 */
/dts-v1/;
#include <st/f2/stm32f207Xe.dtsi>
#include <st/f2/stm32f207v(c-e-f-g)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "Phoenix Contact EV-CC-AC1-M3-CBC-RCM-ETH";
	compatible = "phoenix,ev-cc-ac1";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &app_partition;
		zephyr,entropy = &rng;
	};

	/*
	 * Pins der Ladelogik (Firmwarebefunde des Originals, keine Schaltplanbestaetigung;
	 * Soll-Spezifikation Abschnitt 2). TIM1 (PE9), ADC1 und DMA2 Stream0 konfiguriert
	 * die Anwendung direkt (LL), daher hier ohne Zephyr-Treiberknoten.
	 */
	zephyr,user {
		contactor-gpios = <&gpioe 2 GPIO_ACTIVE_HIGH>;        /* PE2 Schuetz (C1/C2) */
		d5-out-gpios = <&gpioe 1 GPIO_ACTIVE_HIGH>;           /* PE1, Ziel offen */
		ct-sense-gpios = <&gpioe 0 GPIO_ACTIVE_HIGH>;         /* PE0 Klemme CT [HYP] */
		rcm-sw1-gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;          /* SWITCH_1, High = ausgeloest [HYP] */
		rcm-sw2-gpios = <&gpioe 4 GPIO_ACTIVE_HIGH>;          /* SWITCH_2 */
		rcm-err-gpios = <&gpioe 6 GPIO_ACTIVE_HIGH>;          /* ERR_OUT */
		rcm-test-gpios = <&gpioe 5 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* TEST_IN */
		lock-gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;              /* R1/R2 Verriegeln, Low-Impuls */
		unlock-gpios = <&gpioa 10 GPIO_ACTIVE_LOW>;           /* Entriegeln */
		dout-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>,             /* ER */
			     <&gpiob 5 GPIO_ACTIVE_HIGH>,             /* LR */
			     <&gpiob 6 GPIO_ACTIVE_HIGH>,             /* VR */
			     <&gpiob 7 GPIO_ACTIVE_HIGH>;             /* CR */
		dout-enable-gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;      /* DRV8844 nSLEEP [HYP] */
		led-gpios = <&gpioe 15 GPIO_ACTIVE_LOW>,              /* Power */
			    <&gpioe 14 GPIO_ACTIVE_LOW>,              /* Error */
			    <&gpioe 12 GPIO_ACTIVE_LOW>,              /* Connect */
			    <&gpioe 13 GPIO_ACTIVE_LOW>;              /* Ready */
		led-aux-gpios = <&gpioe 10 GPIO_ACTIVE_LOW>,          /* Modem, aus */
				<&gpioe 11 GPIO_ACTIVE_LOW>,
				<&gpioc 2 GPIO_ACTIVE_LOW>;           /* Netzwerk [HYP] */
		dip-gpios = <&gpiod 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, /* D1 */
			    <&gpiod 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpiod 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpiod 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpiod 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpiod 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpioa 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpioa 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpiob 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			    <&gpiob 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* D10 */
		rotary-gpios = <&gpioc 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>, /* Bit 0 */
			       <&gpioc 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			       <&gpioc 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
			       <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* Bit 3 */
		reset-button-gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;      /* [HYP] */
		phy-reset-gpios = <&gpioa 15 GPIO_ACTIVE_LOW>;        /* [HYP] PHY RST# */
		/* Low beim Start (SOLL-IO-01); PC12 uebernimmt danach der Zaehlerbus,
		 * falls ein Zaehler konfiguriert ist (modbus0 unten) */
		rs485-de-gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>,
				 <&gpiod 7 GPIO_ACTIVE_HIGH>;
	};
};

/* HSE 25 MHz (Quarz laut Nutzer); 25/25*200/2 = 100 MHz wie Original (Nutzer 2026-10-19) */
&clk_hse {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

&pll {
	div-m = <25>;
	mul-n = <200>;
	div-p = <2>;
	div-q = <5>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(100)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <2>;
};

/* RMII: PC1 MDC, PA2 MDIO, PA1 REF_CLK, PA7 CRS_DV, PC4/PC5 RXD, PB11 TX_EN, PB12/PB13 TXD */
&mac {
	status = "okay";
	pinctrl-0 = <&eth_rxd0_pc4 &eth_rxd1_pc5 &eth_ref_clk_pa1 &eth_crs_dv_pa7
		     &eth_tx_en_pb11 &eth_txd0_pb12 &eth_txd1_pb13>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
	phy-handle = <&phy>;
};

&mdio {
	status = "okay";
	pinctrl-0 = <&eth_mdio_pa2 &eth_mdc_pc1>;
	pinctrl-names = "default";

	/*
	 * KSZ8081RND, Adresse 0, 25-MHz-Modus (XI ueber 470 Ohm an PA8/MCO1, Durchgang belegt).
	 * "rmii", nicht "rmii-25MHz": der Treiber setzt Reg. 0x1F Bit 7 nach der Logik des RNA
	 * (1 nur bei "rmii"); beim RND waehlt Bit 7 = 1 den 25-MHz-Modus (Datenblatt 3.2.2.1,
	 * Original 0x8180). Mit "rmii-25MHz" fehlte REF_CLK (Testgeraet 2026-10-24).
	 */
	phy: ethernet-phy@0 {
		compatible = "microchip,ksz8081";
		reg = <0x00>;
		microchip,interface-type = "rmii";
	};
};

/* CP-PWM (TIM1 CH1, PE9) und ADC1/DMA2: direkt in der Anwendung, siehe app/src/hw_stm32.c */

/*
 * RS-485 an Klemme A/B: UART4 PC10/PC11, Treiberfreigabe PC12 (Testgeraet geprueft,
 * wallbe2 Belege 9). Energiezaehler, nur Anzeige (Soll-Spezifikation 12.5).
 * Baudrate und Rahmenformat setzt die Anwendung (meter_*).
 */
&uart4 {
	status = "okay";
	pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <9600>;

	modbus0 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
		de-gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>;
	};
};

&iwdg {
	status = "okay";
};

&rtc {
	status = "okay";
};

&backup_sram {
	status = "okay";
};

&flash0 {
	reg = <0x08000000 DT_SIZE_K(512)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Sektoren 0..2: vorhandener Bootloader (nicht anfassen) */
		bootloader_partition: partition@0 {
			label = "bootloader";
			reg = <0x00000000 DT_SIZE_K(48)>;
			read-only;
		};

		/* Sektor 3: Parameter der Originalfirmware (nur lesen) */
		orig_params_partition: partition@c000 {
			label = "orig-params";
			reg = <0x0000c000 DT_SIZE_K(16)>;
			read-only;
		};

		/* Sektoren 4..6: Anwendung (64 + 128 + 128 KB) */
		app_partition: partition@10000 {
			label = "app";
			reg = <0x00010000 DT_SIZE_K(320)>;
		};

		/* Sektor 7: eigene Parameter (Option P1, vorbereiten) */
		storage_partition: partition@60000 {
			label = "storage";
			reg = <0x00060000 DT_SIZE_K(128)>;
		};
	};
};

/* Hardware-Zufallsgenerator (TCP-Sequenznummern, Ports) */
&rng {
	status = "okay";
};
