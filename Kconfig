config WALLFREE_EVSE
	bool "Wallfree Ladelogik (hardwareunabhaengig)"
	help
	  Ladelogik nach docs/soll-spezifikation.md. Reines C ohne
	  Zephyr-Abhaengigkeit, auf dem PC testbar.

config WALLFREE_NVM
	bool "Wallfree Parameterspeicher (hardwareunabhaengig)"
	help
	  Anhaengendes Log-Format in einer Loescheinheit (SOLL-NVM-01..05)
	  und Leser fuer den Parameterbereich der Originalfirmware
	  (SOLL-NVM-10). Reines C, auf dem PC testbar. Mit
	  WALLFREE_EVSE kommt die Persistenz der Ladelogik dazu.

config WALLFREE_API
	bool "Wallfree HTTP-API ohne Netzwerk (hardwareunabhaengig)"
	depends on WALLFREE_EVSE
	help
	  Digest-Authentifizierung (MD5), minimales JSON und Abbildung der
	  Ladelogik auf die WARP-angelehnte API (Soll-Spezifikation 12.1).
	  Reines C, auf dem PC testbar.
