/* Groessentest: Zephyr-PWM- und ADC-Treiber wie beim Messen am 2026-10-19.
 * Die eigentliche Anwendung (app/) steuert TIM1/ADC1 direkt und braucht das nicht. */
&timers1 {
	status = "okay";
	st,prescaler = <49>;

	pwm1: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pe9>;
		pinctrl-names = "default";
	};
};

&adc1 {
	status = "okay";
	pinctrl-0 = <&adc1_in0_pa0 &adc1_in9_pb1>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
};
